# ─────────────────────────────────────────────────────────────────────────────
# HAY Sale Report — .env template (v3.11)
#   1. Copy this file to .env in the same directory
#   2. Fill in the real values (especially GRAPH_CLIENT_SECRET)
#   3. Never commit .env to git — only this .env.example
# ─────────────────────────────────────────────────────────────────────────────

# Odoo XML-RPC connection (v3.13 — moved from daily_report.py so the
# password is never committed to git)
ODOO_URL=https://your-odoo-instance.com
ODOO_DB=your-database-name
ODOO_UID=0
ODOO_PW=replace-with-real-odoo-password

# Microsoft Graph API (Azure AD App Registration)
#   - TENANT_ID:  Directory (tenant) ID from Azure portal (UUID)
#   - CLIENT_ID:  Application (client) ID from Azure portal (UUID)
#   - CLIENT_SECRET:  the "Value" generated under Certificates & secrets
#                     (NOT the Secret ID; copy immediately — shown once)
#   App must have:
#     * API permission Microsoft Graph > Mail.Send (Application type)
#     * Admin consent granted
#     * Application Access Policy restricting it to the noreply mailbox
#       (otherwise the app can send as ANY user in the tenant)
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=replace-with-real-value-from-azure-portal

# v3.12 (optional): Date the GRAPH_CLIENT_SECRET expires (YYYY-MM-DD).
# When set, pipeline prepends a warning to the email body if the secret
# is near expiry:
#   31+ days remaining  -> no warning
#   8-30 days           -> "NOTICE: ... renew before that date"
#   0-7 days / expired  -> "!!! URGENT ..."
# Update both GRAPH_CLIENT_SECRET and this value together when admin
# rotates the secret. Leave blank or remove the line to disable the check.
GRAPH_SECRET_EXPIRES=

# Email config
#   EMAIL_FROM:       the noreply mailbox (must exist in tenant + be in
#                     the Application Access Policy scope)
#   EMAIL_FROM_NAME:  display name shown to recipients
#
# v3.11: EMAIL_TO, EMAIL_CC, EMAIL_BCC all accept COMMA-SEPARATED lists.
#   Whitespace around commas is OK. Empty values (or missing var) = no CC/BCC.
#   Both daily success email and failure notification use all three.
#
EMAIL_FROM=noreply@norserepublics.com
EMAIL_FROM_NAME=Norse Republics — Sales

# Single recipient (legacy):
#   EMAIL_TO=bharkbhum.best@norserepublics.com
# Multiple recipients (v3.11):
#   EMAIL_TO=person1@norserepublics.com, person2@norserepublics.com
EMAIL_TO=bharkbhum.best@norserepublics.com

# Optional — CC recipients (visible to To). Leave blank or remove the line
# entirely if you don't want any CC.
EMAIL_CC=

# Optional — BCC recipients (hidden from To and CC). Leave blank to skip.
EMAIL_BCC=
